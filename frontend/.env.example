# Base API URL:
# Use '/api' to leverage the built-in Vite dev proxy (forwards to http://localhost:3000 and prevents CORS issues)
# Or use full URL 'http://localhost:3000' if CORS is enabled on the backend
VITE_API_URL=/api

# Base URL used for redirect links generated by the backend
VITE_SHORT_URL_BASE=http://localhost:3000
